# Every NEXT_PUBLIC_* value is compiled into public JavaScript. No secrets here.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT=blindstop.testnet
NEXT_PUBLIC_NEAR_RPCS=https://rpc.testnet.fastnear.com,https://near-testnet.drpc.org
NEXT_PUBLIC_HL_NETWORK=testnet
NEXT_PUBLIC_OUTLAYER_API=https://testnet-api.outlayer.ai
NEXT_PUBLIC_OUTLAYER_PROJECT=blindstop-watch.testnet/blindstop-watcher
# Optional: the keeper's public /health endpoint (shown on /watcher)
NEXT_PUBLIC_KEEPER_URL=
