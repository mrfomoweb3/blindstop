# Copy to keeper/.env (never commit it).
NEAR_NETWORK=testnet
# Comma-separated; rotated on failure. Defaults: FastNEAR, dRPC, near.org.
# NEAR_RPC=https://rpc.testnet.fastnear.com,https://near-testnet.drpc.org
BLINDSTOP_CONTRACT=blindstop.testnet
KEEPER_ACCOUNT=blindstop-keeper.testnet
# A FUNCTION-CALL key limited to record_fire + heartbeat on the contract (see docs/operations.md).
# If unset, read from ~/.near-credentials/<network>/<KEEPER_ACCOUNT>.json
KEEPER_PRIVATE_KEY=
OUTLAYER_PROJECT=blindstop-watch.testnet/blindstop-watcher
# owner:nonce:secret — must be owned by the project's operator account (the enclave keys are
# derived for that account; a key owned by anyone else derives different keys and does nothing).
OUTLAYER_PAYMENT_KEY=
# OUTLAYER_API=https://testnet-api.outlayer.ai
TICK_INTERVAL_MS=3000
HEARTBEAT_EVERY=10
# Also heartbeat when this long has passed without one (keeps /watcher fresh if enclave runs are slow; 0 = off)
HEARTBEAT_MAX_GAP_MS=20000
CALL_TIMEOUT_MS=120000
PORT=8787
LOG_LEVEL=info
